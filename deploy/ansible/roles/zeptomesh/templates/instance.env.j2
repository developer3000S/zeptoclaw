# managed by ansible/zeptomesh — см. roles/zeptomesh/templates/instance.env.j2
#
# Набор переменных совпадает с install.sh (write_instance_env) и
# deploy/docker/docker-compose.yml. Узел раскрывает их сам: ${VAR:-default} —
# internal/config.expandEnv, ZEPTOMESH_BOOTSTRAP дописывается в
# discovery.bootstrap — config.applyEnvOverrides.
#
# Хост {{ inventory_hostname }}, экземпляр {{ item.index }} ({{ item.name }}).
#
# ВАЖНО: пути в этом файле действуют ВНУТРИ контейнера. Каталог конфигурации
# смонтирован на {{ zeptomesh_container_conf_dir }} (только на чтение), данные —
# на {{ zeptomesh_container_data_root }} (том или bind-каталог хоста). Сам этот
# файл в контейнер не монтируется: ansible читает его на хосте и передаёт
# значения как Env контейнера, поэтому секреты других экземпляров внутрь не
# попадают.
#
# Файл закрыт правами 0600: здесь PSK закрытой сети и bearer-токен админ-API.
ZEPTOMESH_INDEX={{ item.index }}
ZEPTOMESH_NAME={{ item.name }}
ZEPTOMESH_DATA={{ zeptomesh_container_data_root }}
ZEPTOMESH_CONFIG={{ zeptomesh_container_config_path }}
ZEPTOMESH_MESH_PORT={{ item.mesh_port }}
ZEPTOMESH_API_PORT={{ item.api_port }}
# Bind внутри контейнера — 0.0.0.0: docker публикует порт, обращаясь к адресам
# контейнера в его сетевом пространстве, а не к его loopback (см. ENV
# ZEPTOMESH_API_HOST в deploy/docker/Dockerfile). Наружу порт выходит на
# {{ zeptomesh_api_bind_ip }}.
ZEPTOMESH_API_HOST={{ zeptomesh_api_host }}
{% if zeptomesh_prometheus_enabled | bool %}
# Слушатель метрик тоже 0.0.0.0 по той же причине; наружу — loopback хоста.
ZEPTOMESH_PROM_LISTEN={{ zeptomesh_prom_host }}:{{ item.prom_port }}
{% else %}
# Пустое значение = отдельный слушатель метрик выключен (см. telemetry в конфиге).
ZEPTOMESH_PROM_LISTEN=
{% endif %}
ZEPTOMESH_TRUST_MODE={{ zeptomesh_trust_mode }}
ZEPTOMESH_PICO_MODE={{ zeptomesh_pico_mode }}
ZEPTOMESH_PICO_MODEL={{ zeptomesh_pico_model }}
ZEPTOMESH_MDNS={{ zeptomesh_mdns | bool | lower }}
ZEPTOMESH_DHT_MODE={{ zeptomesh_dht_mode }}
ZEPTOMESH_RELAY_ADVERTISE={{ zeptomesh_relay_advertise | bool | lower }}
ZEPTOMESH_LOG_LEVEL={{ zeptomesh_log_level }}
ZEPTOMESH_PUB_IP={{ zeptomesh_pub_ip }}
ZEPTOMESH_PSK={{ zeptomesh_psk }}
ZEPTOMESH_API_TOKEN={{ zeptomesh_api_token }}
ZEPTOMESH_BOOTSTRAP={{ zeptomesh_bootstrap_effective | default('', true) }}
ZEPTOMESH_ALLOWED_PEERS={{ zeptomesh_container_allowed_peers_path }}
ZEPTOMESH_BLOCKED_PEERS={{ zeptomesh_container_blocked_peers_path }}
{% if zeptomesh_pico_token | default('', true) | length > 0 %}
PICOCLAW_MESH_PICO_TOKEN={{ zeptomesh_pico_token }}
{% endif %}
{% if zeptomesh_relay_1 | default('', true) | length > 0 %}
ZEPTOMESH_RELAY_1={{ zeptomesh_relay_1 }}
{% endif %}
{% if zeptomesh_pico_bin | default('', true) | length > 0 %}
ZEPTOMESH_PICO_BIN={{ zeptomesh_pico_bin }}
{% endif %}
{% if zeptomesh_pico_config | default('', true) | length > 0 %}
ZEPTOMESH_PICO_CONFIG={{ zeptomesh_pico_config }}
{% endif %}
{% if zeptomesh_pico_workspace | default('', true) | length > 0 %}
ZEPTOMESH_PICO_WORKSPACE={{ zeptomesh_pico_workspace }}
{% endif %}
{% for key, value in (zeptomesh_extra_env | default({}, true)).items() %}
{{ key }}={{ value }}
{% endfor %}
