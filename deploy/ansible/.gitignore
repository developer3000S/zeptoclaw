# Артефакты collect_peerids.yml: Peer ID и адреса группы. Секретов здесь нет,
# но это генерируемый снимок состояния сети — в git он только расходится.
collected/

# Зашифрованные и незашифрованные секреты оператора. Реальные значения не
# коммитятся: в репозитории остаётся шаблон .vault.example.yml.
group_vars/**/vault.yml
group_vars/**/vault.*.yml
*.vault-password
.vault-pass

# Рабочая копия инвентаря (в репозиторий попадает только inventory.example.yml:
# в рабочей копии есть реальные адреса хостов).
inventory.yml
hosts.yml
